{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=judesk;Username=judesk;Password=judesk"
  },
  "Auth": {
    "LoginAttemptsPerMinute": 10
  },
  "RateLimits": {
    "RequestsPerMinute": 300,
    "HeavyConcurrency": 2
  },
  "Proxy": {
    "TrustForwardedHeaders": false,
    "ForwardLimit": 1
  },
  "Swagger": {
    "Enabled": true
  },
  "Demo": {
    "Mode": false,
    "ResetMinutes": 60,
    "MaxCatalogRows": 300,
    "MaxShifts": 3000
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Seed": {
    "Demo": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
