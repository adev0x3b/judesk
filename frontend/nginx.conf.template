# Serves the built Vue app and proxies the API on the same origin, so the auth cookie stays first-party.
# The image renders this template at start; only ${TRUST_FORWARDED_PROTO} is substituted.

# Pass on the scheme a TLS terminator in front of nginx (a tunnel or CDN) reports, so the API marks
# the cookie Secure. Only when TRUST_FORWARDED_PROTO=true: without such a proxy, any client could
# claim https.
map "${TRUST_FORWARDED_PROTO}:$http_x_forwarded_proto" $forwarded_proto {
    default $scheme;
    "true:https" https;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Every location includes security-headers.conf itself: nginx drops inherited add_header lines
    # as soon as a location adds one of its own.
    location = /healthz {
        include /etc/nginx/security-headers.conf;
        default_type text/plain;
        return 200 'ok';
    }

    # Swagger UI is inline-script heavy, so it gets the headers minus the CSP.
    location ~ ^/(api|health|swagger)(/|$) {
        include /etc/nginx/security-headers.conf;
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        # The API sets its own copies of these for when it runs without nginx; one set is enough.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        client_max_body_size 1m;
    }

    location /assets/ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        include /etc/nginx/security-headers.conf;
        # The app ships no inline script; styles need 'unsafe-inline' for Vue's bound style attributes.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        # index.html must never be cached: it names the hashed assets of the current build.
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
