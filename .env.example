# Copy to .env and adjust. DB_PASSWORD has no default; everything else does.
# PostgreSQL password, set before the first start (the database keeps the one it was created with).
DB_PASSWORD=
WEB_PORT=8090
# Address the web port is published on. 127.0.0.1 keeps the app local; 0.0.0.0 opens it to the network.
WEB_BIND=127.0.0.1
# IANA time zone the schedule is planned in: weeks, days, shift times and the CSV export.
TIME_ZONE=Europe/Rome
# Seed a sample fleet (technicians, sites, three weeks of shifts) on an empty database.
SEED_DEMO=false
# Public demo: adds "Try the demo" to the login page (a shared planner account, no password)
# and resets technicians, sites, skills and shifts to the sample fleet on a timer. Implies SEED_DEMO.
DEMO_MODE=false
DEMO_RESET_MINUTES=60
# Swagger UI at /swagger.
SWAGGER_ENABLED=false
# Proxies in front of nginx. 1 = nothing, 2 = a tunnel or CDN (Cloudflare) that adds the client address.
PROXY_FORWARD_LIMIT=1
# Set to true only behind a TLS terminator (tunnel, CDN, reverse proxy) that sets X-Forwarded-Proto.
TRUST_FORWARDED_PROTO=false
