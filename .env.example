# Copy to .env and adjust. Every value has a default in docker-compose.yml.
WEB_PORT=8090
# Address the web port is published on. 127.0.0.1 keeps the app local; 0.0.0.0 opens it to the network.
WEB_BIND=127.0.0.1
DB_PASSWORD=judesk
# Set to false to start with an empty schedule instead of the demo fleet.
SEED_DEMO=true
